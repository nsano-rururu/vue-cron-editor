{
  "name": "vue-cron-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "link-parent-bin -c src",
    "release:samples": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "buefy": "^0.9.29",
    "bulma": "^1.0.4",
    "core-js": "^3.38.1",
    "cron-validator": "^1.3.1",
    "cronstrue": "^2.50.0",
    "vue": "^2.7.16",
    "vuetify": "^2.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-vue2": "^2.3.1",
    "@vue/test-utils": "^1.3.6",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "fast-check": "^3.22.0",
    "gh-pages": "^6.2.0",
    "globals": "^17.5.0",
    "jsdom": "^25.0.1",
    "link-parent-bin": "^2.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "sass": "^1.80.6",
    "standard-version": "^9.5.0",
    "typescript": "^5.6.3",
    "vite": "^4.5.14",
    "vite-plugin-vue2": "^2.0.3",
    "vitest": "^1.6.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^2.1.10"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "**/*.{ts,js,vue}": [
      "eslint --fix"
    ]
  }
}
