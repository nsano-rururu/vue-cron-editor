{
  "name": "vue-cron-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "type-check": "vue-tsc --noEmit",
    "release:samples": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "buefy": "^1.0.1",
    "bulma": "0.9.4",
    "core-js": "^3.35.0",
    "cron-validator": "^1.3.1",
    "cronstrue": "^2.50.0",
    "vue": "^3.4.0",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-vue": "^9.28.0",
    "fast-check": "^3.15.0",
    "gh-pages": "^6.1.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "sass": "^1.79.0",
    "typescript": "~5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "**/*.{ts,js,vue}": [
      "eslint --fix"
    ]
  }
}
